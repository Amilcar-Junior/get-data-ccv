# -----------------------------------------------------------------------------
# Intervalo do cron (minutos)
# O Vercel dispara /api/cron/check-slots a cada 1 minuto (vercel.json).
# O script só consulta o MNE se já tiverem passado CHECK_INTERVAL_MINUTES.
# Ex.: 5 = verifica de 5 em 5 minutos.
# -----------------------------------------------------------------------------
CHECK_INTERVAL_MINUTES=5

# Evita spam: não reenvia e-mail com a mesma resposta durante este período.
NOTIFY_COOLDOWN_MINUTES=30

# Opcionais. O POST automático (GitHub Action + cron Vercel + next dev) não precisa delas.
# CRON_SECRET=altere-para-um-segredo-longo
# API_KEY=altere-para-uma-chave-longa

# -----------------------------------------------------------------------------
# Pedido ao portal Vistos Online (MNE)
# -----------------------------------------------------------------------------
POSTO_ID=5084
SLOTS_BASE_URL=https://pedidodevistos.mne.gov.pt/VistosOnline/slots

# Cookie completo do browser (valor do header Cookie / flag -b do curl)
# Ex.: Vistos_sid=...; user_consent=1; cookiesession1=...
VISTOS_COOKIE=

# Token captcha do formulário (expira — atualize no dashboard da Vercel)
VISTOS_CAPTCHA=

# Opcional. Se vazio, usa o User-Agent do Edge/Chrome documentado no OpenAPI.
VISTOS_USER_AGENT=

# -----------------------------------------------------------------------------
# E-mail (Gmail com senha de aplicação)
# Conta Google → Segurança → Verificação em 2 passos → Senhas de app
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu-email@gmail.com
SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM=seu-email@gmail.com
EMAIL_TO=seu-email@gmail.com
